[Unit]
Description=Restart mihomo after resume from sleep (waits for network)
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
# 等待物理网卡拿到默认路由（即 WiFi/有线真正连上），最长等 180 秒，超时也照常重启
ExecStartPre=/bin/sh -c 'for i in $(seq 1 90); do ip -4 route show default | grep -qE "dev (wlan|en|eth|ww)" && exit 0; sleep 2; done; exit 0'
ExecStart=/usr/bin/systemctl restart mihomo.service

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

# 有问题日志检查命令
# journalctl -b -u mihomo-after-resume.service -u mihomo --no-pager | tail -10
